    "            - text: \"Introduction\"\n",
    "              href: \"#introduction\"\n",
    "            - text: \"Tabular RL\"\n",
    "              href: \"#tabular-rl\"\n",
    "            - text: \"Model-free RL\"\n",
    "              href: \"#model-free-rl\"\n",
    "            - text: \"Model-based RL\"\n",
    "              href: \"#model-based-rl\"\n",
    "        - text: \"Slides\"\n",
    "          menu:\n",
    "            - text: \"All Slides\"\n",
    "              href: \"slides/\"\n",
    "            - text: \"---\"\n",
    "            - text: \"Introduction\"\n",
    "              href: \"slides/0-Introduction.html\"\n",
    "            - text: \"Bandits\"\n",
    "              href: \"slides/1.1-Bandits.html\"\n",
    "            - text: \"MDP\"\n",
    "              href: \"slides/1.2-MDP.html\"\n",
    "        - text: \"Resources\"\n",
    "          menu:\n",
    "            - text: \"GitHub Repository\"\n",
    "              href: \"https://github.com/phatcvo/Lec-DRL\"\n",
    "            - text: \"Bibliography\"\n",
    "              href: \"#bibliography\"\n",
    "      right:\n",
    "        - icon: github\n",
