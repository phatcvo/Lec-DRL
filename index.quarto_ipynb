   "source": [
    "---\n",
    "title: \"Deep Reinforcement Learning\"\n",
    "subtitle: \"A Comprehensive Course on Modern Reinforcement Learning\"\n",
    "author: \"\"\n",
    "date: \"\"\n",
    "echo: false\n",
    "format:\n",
    "  html:\n",
    "    theme: cosmo\n",
    "    css: [assets/custom.scss, assets/homepage.scss]\n",
    "    toc: true\n",
    "    toc-location: left\n",
    "    toc-title: \"Course Contents\"\n",
    "    navbar:\n",
    "      title: \"Deep RL Course\"\n",
    "      left:\n",
    "        - text: \"Home\"\n",
